# Copy to .env (or .env.local for machine-specific overrides) and fill in.
# Vite only exposes variables prefixed with VITE_ to the client bundle, so
# these must be public values. Never commit a service_role key here.

# --- Supabase (المصادقة والجداول فقط — الوسائط عبر ImageKit.io) ---
# مشروع Supabase الجديد: شغّل supabase/fresh_schema_cloudflare_r2.sql عليه.
# ملاحظة: هذه القيم عامة (publishable) بتصميم Supabase — سرّ الخادم الوحيد
# المطلوب في Secrets هو SUPABASE_SERVICE_ROLE_KEY.
VITE_SUPABASE_URL=https://auqqqwfjxrxizlmeweka.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_RD_YttgesZJraGb7dvuArQ_ggxUCfmt
# Optional alias used by some existing setups (same value as above).
VITE_SUPABASE_PUBLISHABLE_KEY=
# قاعدة قديمة متوافقة فقط — في قاعدة البيانات الجديدة لم يعد يُستخدم
# (روابط الوسائط تُخزَّن كعناوين R2 كاملة في posts.media_url).
VITE_SUPABASE_STORAGE_BUCKET=

# --- ImageKit.io (رفع وعرض الصور والفيديوهات والريلز) ---
# سرّية: تُقرأ من الخادم الخلفي (api-server) فقط لتوليد توقيع الرفع الآمن.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/anisocial
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key

# --- Firebase Cloud Messaging (قيم تطبيق الويب العامة + مفتاح VAPID) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ani1-20bed
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- الموسيقى في الستوري ---
# false (الافتراضي): يظهر للعميل نافذة «ميزة الموسيقى قادمة قريباً»
# true: تُفتح واجهة اختيار الأغاني الحقيقية عبر المزوّد المسجّل أدناه
VITE_MUSIC_FEATURE_ENABLED=false
# معرّف المزوّد الموسيقي المسجّل عبر registerMusicProvider (فارغ = لا مزوّد بعد)
VITE_MUSIC_PROVIDER_ID=

